# Copy to backend/.env and replace the placeholders. Never commit backend/.env.
# Local fallback:
# DATABASE_URL=sqlite:///./smartclean.db
# PostgreSQL/PostGIS:
DATABASE_URL=postgresql+psycopg://postgres:replace-with-local-password@localhost:5432/mzuzu_smartclean
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
BOUNDARY_GEOJSON_PATH=data/mzuzu_boundary.geojson
# Set true only after a trusted Mzuzu study boundary has been verified.
BOUNDARY_VERIFIED=false
CORS_ORIGINS=["http://localhost:5173"]
APP_ENV=development
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=60
SEED_DEFAULT_ACCOUNTS=false
